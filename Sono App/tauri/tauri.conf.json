{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Sono",
  "version": "2.4.2",
  "identifier": "app.sono.desktop",
  "build": {
    "frontendDist": "www"
  },
  "app": {
    "windows": [],
    "security": {
      "csp": null
    },
    "withGlobalTauri": false
  },
  "bundle": {
    "active": true,
    "targets": [
      "dmg",
      "nsis"
    ],
    "publisher": "Sono",
    "copyright": "© 2026 Sono. Logiciel libre sous licence AGPL-3.0.",
    "category": "Music",
    "shortDescription": "Sono",
    "longDescription": "Sono, la file musicale collaborative pour vos soirées.",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "resources": {
      "../dist/": "dist/"
    },
    "macOS": {
      "minimumSystemVersion": "12.0",
      "signingIdentity": "-",
      "files": {
        "Resources/Assets.car": "icon/Assets.car"
      }
    },
    "windows": {
      "nsis": {
        "installMode": "currentUser",
        "languages": [
          "French"
        ],
        "compression": "bzip2",
        "installerHooks": "windows/hooks.nsh"
      }
    }
  }
}
