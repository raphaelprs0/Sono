{
  "name": "sono-mobile",
  "main": "src/worker.js",
  "compatibility_date": "2026-09-01",
  "compatibility_flags": ["nodejs_compat"],
  "assets": { "directory": "../web/dist", "binding": "ASSETS", "not_found_handling": "single-page-application", "run_worker_first": ["/api/*", "/ws"] },
  "durable_objects": { "bindings": [{ "name": "SONO_HUB", "class_name": "SonoHub" }] },
  "migrations": [{ "tag": "v1", "new_sqlite_classes": ["SonoHub"] }]
}
